# Public frontend configuration. Safe to include in the Vite build.
# Use the Project URL and publishable/anon key from Supabase project settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Wix client ID remains needed for Bookings and other retained Wix integrations.
VITE_WIX_CLIENT_ID=

# These are legacy temporary Wix API settings for the prior Vercel test backend.
# Do not use them for Supabase authentication or expose them in frontend code.
WIX_SITE_ID=
WIX_API_KEY=
BSDA_ALLOWED_ORIGIN=http://localhost:5173,https://bsda.online,https://www.bsda.online

# Never place SUPABASE_SERVICE_ROLE_KEY here if this file is used by Vite.
# A service-role key must only exist in a trusted server environment.
