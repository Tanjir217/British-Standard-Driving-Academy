# Public frontend configuration. Safe to include in the Vite build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key name is supported by the client as a fallback only.
# VITE_SUPABASE_ANON_KEY=

# Retain Wix client configuration for Bookings and other Wix integrations.
VITE_WIX_CLIENT_ID=

# Legacy Vercel/Wix API variables; not used for Supabase Auth or portal data.
WIX_SITE_ID=
WIX_API_KEY=
BSDA_ALLOWED_ORIGIN=http://localhost:5173,https://bsda.online,https://www.bsda.online

# NEVER expose a Supabase service-role/secret key in VITE_* variables or Git.
