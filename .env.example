# Vercel server-side environment variables.
# Copy the required values into Vercel Project Settings > Environment Variables
# and into a local .env.local file for development. Never commit real secrets.

# Public Wix Headless app/client ID. This value is not a secret.
VITE_WIX_CLIENT_ID=

# Server-side Wix site identity.
WIX_SITE_ID=

# Privileged Wix API key. SERVER ONLY: never prefix with VITE_.
WIX_API_KEY=

# Exact public frontend origin allowed to call the API (e.g. https://bsda.online).
# For local development, use http://localhost:5173.
BSDA_ALLOWED_ORIGIN=http://localhost:5173
