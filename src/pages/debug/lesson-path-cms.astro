---
import { LessonPathCmsDebug } from "../../components/debug/LessonPathCmsDebug";
export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#101a33" />
    <title>BSDA Lesson CMS Debug</title>
  </head>
  <body>
    <LessonPathCmsDebug client:only="react" />
  </body>
</html>

<style is:global>
  :root { font-family: Arial, Helvetica, sans-serif; color: #101a33; background: #f5f6f8; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  button, input { font: inherit; }
  .debug-page { max-width: 1240px; margin: 0 auto; padding: 36px 22px 60px; }
  .debug-header { margin-bottom: 24px; padding: 30px; border-radius: 16px; background: #101a33; color: #fff; }
  .debug-eyebrow { display: block; color: #d51f2a; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; }
  .debug-header .debug-eyebrow { color: #ff9da4; }
  .debug-header h1 { margin: 10px 0; font: 700 clamp(28px, 4vw, 40px)/1.1 Georgia, serif; }
  .debug-header p { max-width: 760px; color: #d2d7e2; font-size: 14px; line-height: 1.65; }
  .debug-header small { display: inline-block; margin-left: 14px; color: #cbd5e1; font-size: 11px; }
  .debug-run { margin-top: 8px; padding: 11px 16px; border: 0; border-radius: 8px; background: #d51f2a; color: #fff; font-weight: 700; cursor: pointer; }
  .debug-run:disabled { opacity: .6; cursor: wait; }
  .debug-card { margin-top: 18px; padding: 24px; border: 1px solid #e1e4eb; border-radius: 14px; background: #fff; box-shadow: 0 8px 28px rgba(16,26,51,.04); }
  .debug-card-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .debug-card h2 { margin: 5px 0 0; color: #101a33; font: 700 23px/1.2 Georgia, serif; }
  .debug-status { display: inline-flex; align-items: center; padding: 7px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; white-space: nowrap; }
  .debug-status.success { color: #17663d; background: #e7f7ed; }
  .debug-status.failure { color: #a41922; background: #fdebed; }
  .debug-status.pending { color: #775600; background: #fff4cf; }
  .debug-muted { color: #687084; font-size: 12px; line-height: 1.6; }
  .debug-card code { overflow-wrap: anywhere; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 11px; }
  .debug-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 18px 0; }
  .debug-metrics > div { display: flex; flex-direction: column; gap: 5px; padding: 14px; border-radius: 9px; background: #f4f6fa; }
  .debug-metrics strong { color: #101a33; font-size: 22px; }
  .debug-metrics span { color: #687084; font-size: 11px; }
  .debug-table-wrap { overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 9px; }
  .debug-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .debug-table th, .debug-table td { padding: 12px; border-bottom: 1px solid #e8eaf0; text-align: left; vertical-align: top; }
  .debug-table th { background: #f4f6fa; color: #424b5e; font-size: 10px; text-transform: uppercase; letter-spacing: .5px; }
  .debug-table tr:last-child td { border-bottom: 0; }
  .debug-table td small { display: block; margin-top: 4px; color: #8a91a0; }
  .debug-table em { color: #a41922; }
  .debug-error { padding: 12px; border: 1px solid #f4c7cb; border-radius: 8px; background: #fff0f1; color: #9f1d27; font-size: 13px; overflow-wrap: anywhere; }
  .debug-empty { padding: 14px; border-radius: 8px; background: #f4f6fa; color: #596174; font-size: 13px; }
  .debug-warning { color: #8a5300; font-size: 12px; line-height: 1.6; }
  .debug-next ul { padding-left: 20px; color: #596174; font-size: 13px; line-height: 1.8; }
  .debug-next li { margin: 5px 0; }
  .debug-next li strong { color: #101a33; }
  @media (max-width: 600px) {
    .debug-page { padding: 14px 10px 36px; }
    .debug-header, .debug-card { padding: 18px; }
    .debug-card h2 { font-size: 20px; }
    .debug-metrics { gap: 6px; }
    .debug-metrics > div { padding: 10px 8px; }
    .debug-metrics strong { font-size: 18px; }
    .debug-metrics span { font-size: 10px; }
    .debug-header small { display: block; margin: 10px 0 0; }
  }
</style>
